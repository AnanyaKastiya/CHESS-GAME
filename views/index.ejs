<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'ChessMate' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .chessboard {
            display: grid;
            grid-template-columns: repeat(8, minmax(0, 1fr));
            grid-template-rows: repeat(8, minmax(0, 1fr));
            width: min(85vw, 480px);
            height: min(85vw, 480px);
            user-select: none;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.5);
            border: 4px solid #27272a;
            border-radius: 8px;
            overflow: hidden;
        }

        .square {
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .square.light {
            background-color: #f0d9b5;
        }

        .square.dark {
            background-color: #b58863;
        }

        .square.highlight-last {
            background-color: #ced26b !important;
        }

        .square.in-check {
            background-color: #e57373 !important;
        }

        .piece {
            font-size: clamp(28px, 6vw, 46px);
            cursor: pointer;
            transition: transform 0.1s ease;
            z-index: 10;
        }

        .piece.white {
            color: #ffffff;
            filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.9));
        }

        .piece.black {
            color: #18181b;
            filter: drop-shadow(0 1px 2px rgba(255, 255, 255, 0.3));
        }

        .piece.draggable {
            cursor: grab;
        }

        .piece.draggable:active {
            cursor: grabbing;
        }

        .flipped {
            transform: rotate(180deg);
        }

        .flipped .piece {
            transform: rotate(180deg);
        }

        .clock {
            font-family: monospace;
            letter-spacing: 0.05em;
        }

        /* Legal move dot indicator */
        .legal-hint::after {
            content: '';
            width: 16px;
            height: 16px;
            background: rgba(40, 167, 69, 0.6);
            border-radius: 50%;
            position: absolute;
            z-index: 5;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #18181b;
        }
        ::-webkit-scrollbar-thumb {
            background: #3f3f46;
            border-radius: 4px;
        }
    </style>
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col font-sans selection:bg-emerald-500 selection:text-white">

    <!-- Top Navigation Bar -->
    <header class="border-b border-zinc-800 bg-zinc-900/80 backdrop-blur px-6 py-3 flex items-center justify-between sticky top-0 z-50">
        <div class="flex items-center gap-3">
            <span class="text-2xl text-emerald-500">♟️</span>
            <div>
                <h1 class="font-bold text-lg leading-tight tracking-tight flex items-center gap-2">
                    ChessMate
                    <span class="text-xs font-semibold px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Multiplayer</span>
                </h1>
                <p class="text-xs text-zinc-400">Server-Authoritative Real-Time Platform</p>
            </div>
        </div>

        <div class="flex items-center gap-4">
            <!-- Connection Status Badge -->
            <div id="connectionBadge" class="flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-800 border border-zinc-700 text-xs text-zinc-300">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span id="connectionText">Connected</span>
            </div>

            <!-- User Auth Profile Button -->
            <div id="userProfileSection">
                <button id="authModalBtn" class="px-4 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-sm font-medium transition flex items-center gap-2">
                    <i class="fa-solid fa-user"></i>
                    <span id="userDisplayName">Sign In</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 md:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

        <!-- Left Controls Column -->
        <div class="lg:col-span-3 space-y-4">
            <!-- Matchmaking Card -->
            <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-4 shadow-sm">
                <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400 mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-bolt text-yellow-400"></i> Quick Match
                </h2>
                <div id="matchmakingControls" class="space-y-3">
                    <button id="findMatchBtn" class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-lg shadow-lg shadow-emerald-900/20 transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-magnifying-glass"></i> Find Match (10 min)
                    </button>
                    <div id="queueStatus" class="hidden text-center py-2 px-3 bg-zinc-800/80 rounded-lg border border-zinc-700">
                        <p class="text-xs text-emerald-400 flex items-center justify-center gap-2">
                            <i class="fa-solid fa-spinner fa-spin"></i> Searching for opponent...
                        </p>
                        <button id="cancelQueueBtn" class="mt-2 text-xs text-red-400 hover:underline">Cancel Search</button>
                    </div>
                </div>
            </div>

            <!-- Custom Room Card -->
            <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-4 shadow-sm">
                <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400 mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-door-open text-blue-400"></i> Private Room
                </h2>
                <div class="space-y-3">
                    <button id="createRoomBtn" class="w-full py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-medium rounded-lg border border-zinc-700 transition flex items-center justify-center gap-2 text-sm">
                        <i class="fa-solid fa-plus"></i> Create New Room
                    </button>
                    <div class="flex gap-2">
                        <input id="roomCodeInput" type="text" placeholder="Enter Room ID" class="flex-1 bg-zinc-950 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm text-zinc-200 placeholder-zinc-500 focus:outline-none focus:border-emerald-500">
                        <button id="joinRoomBtn" class="px-3 py-1.5 bg-zinc-800 hover:bg-zinc-700 text-sm font-medium rounded-lg border border-zinc-700 transition">Join</button>
                    </div>
                </div>
            </div>

            <!-- Active Room Info & Game Actions -->
            <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-4 shadow-sm">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400 flex items-center gap-2">
                        <i class="fa-solid fa-gamepad text-purple-400"></i> Match Actions
                    </h2>
                    <span id="currentRoomLabel" class="text-xs px-2 py-0.5 bg-zinc-800 rounded border border-zinc-700 text-zinc-400">Room: lobby</span>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <button id="resignBtn" class="py-2 bg-red-950/40 hover:bg-red-900/60 text-red-400 border border-red-900/40 text-xs font-semibold rounded-lg transition flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-flag"></i> Resign
                    </button>
                    <button id="copyLinkBtn" class="py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 text-xs font-semibold rounded-lg transition flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-share-nodes"></i> Share Room
                    </button>
                </div>
            </div>
        </div>

        <!-- Center Column: Chessboard & Clocks -->
        <div class="lg:col-span-6 flex flex-col items-center justify-center space-y-3">
            
            <!-- Top Player (Black by default) -->
            <div class="w-full max-w-[480px] flex items-center justify-between px-3 py-2 bg-zinc-900 border border-zinc-800 rounded-lg">
                <div class="flex items-center gap-2.5">
                    <span id="topPlayerColor" class="w-3.5 h-3.5 rounded-full bg-zinc-800 border border-zinc-600"></span>
                    <div>
                        <p id="topPlayerName" class="text-sm font-semibold text-zinc-200">Waiting for Black...</p>
                        <p id="topPlayerStatus" class="text-xs text-zinc-500">Offline</p>
                    </div>
                </div>
                <div id="topClock" class="clock text-xl font-bold bg-zinc-950 px-3 py-1 rounded border border-zinc-800 text-zinc-200">
                    10:00
                </div>
            </div>

            <!-- The Chessboard Container -->
            <div class="relative">
                <div class="chessboard"></div>
                
                <!-- Status Overlay Banner -->
                <div id="gameStatusBanner" class="hidden absolute inset-0 bg-black/75 backdrop-blur-sm flex flex-col items-center justify-center rounded-lg z-20 text-center p-6 space-y-3">
                    <h3 id="bannerTitle" class="text-2xl font-bold text-emerald-400">Game Over</h3>
                    <p id="bannerSubtitle" class="text-sm text-zinc-300">White wins by Checkmate</p>
                    <button id="playAgainBtn" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold rounded-lg transition">Find Another Match</button>
                </div>
            </div>

            <!-- Bottom Player (White by default) -->
            <div class="w-full max-w-[480px] flex items-center justify-between px-3 py-2 bg-zinc-900 border border-zinc-800 rounded-lg">
                <div class="flex items-center gap-2.5">
                    <span id="bottomPlayerColor" class="w-3.5 h-3.5 rounded-full bg-white border border-zinc-300"></span>
                    <div>
                        <p id="bottomPlayerName" class="text-sm font-semibold text-zinc-200">Waiting for White...</p>
                        <p id="bottomPlayerStatus" class="text-xs text-zinc-500">Offline</p>
                    </div>
                </div>
                <div id="bottomClock" class="clock text-xl font-bold bg-zinc-950 px-3 py-1 rounded border border-zinc-800 text-zinc-200">
                    10:00
                </div>
            </div>

            <!-- Active Turn & Spectators Indicator -->
            <div class="w-full max-w-[480px] flex items-center justify-between text-xs text-zinc-400 px-1">
                <span id="turnIndicator" class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span> White to move
                </span>
                <span id="spectatorBadge" class="flex items-center gap-1">
                    <i class="fa-solid fa-eye text-zinc-500"></i> <span id="spectatorsCount">0</span> spectators
                </span>
            </div>
        </div>

        <!-- Right Column: Move History & Leaderboard Tabs -->
        <div class="lg:col-span-3 bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden flex flex-col h-[560px]">
            <!-- Tab Headers -->
            <div class="flex border-b border-zinc-800 bg-zinc-950/60 text-xs font-semibold">
                <button id="tabMovesBtn" class="flex-1 py-3 text-center border-b-2 border-emerald-500 text-emerald-400">Move History</button>
                <button id="tabLeaderboardBtn" class="flex-1 py-3 text-center text-zinc-400 hover:text-zinc-200">Leaderboard</button>
            </div>

            <!-- Tab 1: Moves List -->
            <div id="tabMoves" class="flex-1 p-3 overflow-y-auto space-y-1 text-sm font-mono">
                <div id="movesList" class="divide-y divide-zinc-800/60">
                    <p class="text-xs text-zinc-500 italic text-center py-4">No moves played yet.</p>
                </div>
            </div>

            <!-- Tab 2: Leaderboard -->
            <div id="tabLeaderboard" class="hidden flex-1 p-3 overflow-y-auto space-y-2">
                <div id="leaderboardList" class="space-y-2">
                    <p class="text-xs text-zinc-500 text-center py-4">Loading top players...</p>
                </div>
            </div>
        </div>
    </main>

    <!-- Pawn Promotion Modal -->
    <div id="promotionModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center">
        <div class="bg-zinc-900 border border-zinc-700 rounded-xl p-5 max-w-xs w-full text-center space-y-4 shadow-2xl">
            <h3 class="text-base font-bold text-zinc-100">Promote Pawn</h3>
            <p class="text-xs text-zinc-400">Choose the piece to promote your pawn into:</p>
            <div class="grid grid-cols-4 gap-2">
                <button data-piece="q" class="promotion-choice py-3 bg-zinc-800 hover:bg-emerald-600 rounded-lg text-2xl transition">♛</button>
                <button data-piece="r" class="promotion-choice py-3 bg-zinc-800 hover:bg-emerald-600 rounded-lg text-2xl transition">♜</button>
                <button data-piece="b" class="promotion-choice py-3 bg-zinc-800 hover:bg-emerald-600 rounded-lg text-2xl transition">♝</button>
                <button data-piece="n" class="promotion-choice py-3 bg-zinc-800 hover:bg-emerald-600 rounded-lg text-2xl transition">♞</button>
            </div>
        </div>
    </div>

    <!-- User Auth Modal -->
    <div id="authModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-zinc-900 border border-zinc-700 rounded-xl p-6 max-w-sm w-full space-y-4 shadow-2xl relative">
            <button id="closeAuthModal" class="absolute top-4 right-4 text-zinc-400 hover:text-white text-lg">✕</button>
            
            <div class="flex border-b border-zinc-800 text-sm font-semibold pb-2">
                <button id="authTabLogin" class="flex-1 text-emerald-400 border-b-2 border-emerald-500 pb-1">Sign In</button>
                <button id="authTabRegister" class="flex-1 text-zinc-400 pb-1">Register</button>
            </div>

            <form id="authForm" class="space-y-3">
                <div id="usernameField" class="hidden">
                    <label class="text-xs text-zinc-400">Username</label>
                    <input id="authUsername" type="text" placeholder="ChessMate123" class="w-full bg-zinc-950 border border-zinc-700 rounded-lg px-3 py-2 text-sm text-zinc-200 focus:outline-none focus:border-emerald-500 mt-1">
                </div>
                <div>
                    <label class="text-xs text-zinc-400">Email or Username</label>
                    <input id="authEmail" type="text" placeholder="player@domain.com" required class="w-full bg-zinc-950 border border-zinc-700 rounded-lg px-3 py-2 text-sm text-zinc-200 focus:outline-none focus:border-emerald-500 mt-1">
                </div>
                <div>
                    <label class="text-xs text-zinc-400">Password</label>
                    <input id="authPassword" type="password" placeholder="••••••••" required class="w-full bg-zinc-950 border border-zinc-700 rounded-lg px-3 py-2 text-sm text-zinc-200 focus:outline-none focus:border-emerald-500 mt-1">
                </div>
                <button type="submit" id="authSubmitBtn" class="w-full py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-lg transition text-sm">Sign In</button>
                <p id="authErrorMsg" class="hidden text-xs text-red-400 text-center"></p>
            </form>
        </div>
    </div>

    <!-- Client Scripts -->
    <script src="https://cdn.socket.io/4.8.1/socket.io.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
    <script src="/js/chessgame.js"></script>
</body>
</html>